      <div class="navbar-end">
        <div class="navbar-item has-dropdown is-hoverable">
          <a class="navbar-link">Компоненты</a>
          <div class="navbar-dropdown">
            <a class="navbar-item" href="{{{relativize (resolvePageURL 'project-guide:ROOT:index.adoc')}}}">Руководство по документированию</a>
            <a class="navbar-item" href="{{{relativize (resolvePageURL 'data-processing-engine:ROOT:index.adoc')}}}">Центр обработки данных</a>
            <a class="navbar-item" href="{{{relativize (resolvePageURL 'information-system:ROOT:index.adoc')}}}">Информационная система</a>
            <a class="navbar-item" href="{{{relativize (resolvePageURL 'airport-service:ROOT:index.adoc')}}}">Сервис аэропортов</a>
            <a class="navbar-item" href="{{{relativize (resolvePageURL 'toys-service:ROOT:index.adoc')}}}">Сервис игрушек</a>
